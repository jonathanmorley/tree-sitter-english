{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "english",
      "camelcase": "English",
      "title": "English",
      "scope": "source.english",
      "path": ".",
      "file-types": [
        "en",
        "txt"
      ]
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "A proof-of-concept tree-sitter grammar for English prose",
    "authors": [
      {
        "name": "Alexis Purslane"
      }
    ],
    "links": {
      "repository": "https://tangled.org/xenolandscapes.com/tree-sitter-english"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
