{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "english",
      "camelcase": "English",
      "title": "English",
      "scope": "source.english",
      "file-types": [
        "en",
        "txt"
      ],
      "path": "."
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "A proof-of-concept tree-sitter grammar for English prose",
    "authors": [
      {
        "name": "Alexis Purslane"
      }
    ],
    "links": {
      "repository": "https://example.invalid/english_ts"
    }
  }
}
