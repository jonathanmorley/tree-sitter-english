{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "english",
  "rules": {
    "source_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "paragraph_break"
          }
        },
        {
          "type": "SYMBOL",
          "name": "paragraph"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "REPEAT1",
                "content": {
                  "type": "SYMBOL",
                  "name": "paragraph_break"
                }
              },
              {
                "type": "SYMBOL",
                "name": "paragraph"
              }
            ]
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "paragraph_break"
          }
        }
      ]
    },
    "paragraph": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "sentence"
      }
    },
    "sentence": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "clause"
            },
            {
              "type": "SYMBOL",
              "name": "subordinate_clause"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "conjunction"
                  },
                  {
                    "type": "CHOICE",
                    "members": [
                      {
                        "type": "SYMBOL",
                        "name": "clause"
                      },
                      {
                        "type": "SYMBOL",
                        "name": "subordinate_clause"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "semicolon"
                  },
                  {
                    "type": "CHOICE",
                    "members": [
                      {
                        "type": "SYMBOL",
                        "name": "clause"
                      },
                      {
                        "type": "SYMBOL",
                        "name": "subordinate_clause"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "colon"
                  },
                  {
                    "type": "CHOICE",
                    "members": [
                      {
                        "type": "SYMBOL",
                        "name": "clause"
                      },
                      {
                        "type": "SYMBOL",
                        "name": "subordinate_clause"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "em_dash"
                  },
                  {
                    "type": "CHOICE",
                    "members": [
                      {
                        "type": "SYMBOL",
                        "name": "clause"
                      },
                      {
                        "type": "SYMBOL",
                        "name": "subordinate_clause"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "SYMBOL",
                "name": "subordinate_clause"
              }
            ]
          }
        },
        {
          "type": "SYMBOL",
          "name": "_sentence_end"
        }
      ]
    },
    "_sentence_end": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_end_dot"
            },
            {
              "type": "PATTERN",
              "value": "[?!]"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "[\"'\\u2018\\u2019\\u201D\\u201C]"
              },
              {
                "type": "PATTERN",
                "value": "[)\\]}]"
              }
            ]
          }
        }
      ]
    },
    "clause": {
      "type": "PREC_LEFT",
      "value": 0,
      "content": {
        "type": "REPEAT1",
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_wordish"
            },
            {
              "type": "SYMBOL",
              "name": "period"
            },
            {
              "type": "SYMBOL",
              "name": "_comma"
            },
            {
              "type": "SYMBOL",
              "name": "quote"
            }
          ]
        }
      }
    },
    "subordinate_clause": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "subordinator"
        },
        {
          "type": "PREC_LEFT",
          "value": 0,
          "content": {
            "type": "REPEAT1",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "_wordish"
                },
                {
                  "type": "SYMBOL",
                  "name": "period"
                },
                {
                  "type": "SYMBOL",
                  "name": "_comma"
                },
                {
                  "type": "SYMBOL",
                  "name": "conjunction"
                },
                {
                  "type": "SYMBOL",
                  "name": "subordinate_clause"
                },
                {
                  "type": "SYMBOL",
                  "name": "quote"
                }
              ]
            }
          }
        }
      ]
    },
    "paragraph_break": {
      "type": "PATTERN",
      "value": "\\r?\\n[ \\t]*\\r?\\n"
    },
    "_comma": {
      "type": "STRING",
      "value": ","
    },
    "semicolon": {
      "type": "STRING",
      "value": ";"
    },
    "colon": {
      "type": "STRING",
      "value": ":"
    },
    "em_dash": {
      "type": "PATTERN",
      "value": "—|–"
    },
    "quote": {
      "type": "PATTERN",
      "value": "[\"'\\u2018\\u2019\\u201C\\u201D]"
    },
    "_wordish": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "word"
        },
        {
          "type": "SYMBOL",
          "name": "dotted"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        }
      ]
    },
    "dotted": {
      "type": "PATTERN",
      "value": "[A-Za-z]+(\\.[A-Za-z]+)+\\.?"
    },
    "number": {
      "type": "PATTERN",
      "value": "\\d+(\\.\\d+)?"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "_end_dot"
    },
    {
      "type": "SYMBOL",
      "name": "period"
    },
    {
      "type": "SYMBOL",
      "name": "word"
    },
    {
      "type": "SYMBOL",
      "name": "conjunction"
    },
    {
      "type": "SYMBOL",
      "name": "subordinator"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}